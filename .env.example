# ---------------------------------------------------------------------------
# Chic Planet Store Manager — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# In production, set these in Vercel Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (provided by the Neon integration).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Bearer token the ChatGPT connector must send (Authorization: Bearer <token>).
# Generate a strong secret, e.g.:  openssl rand -base64 48
MCP_API_TOKEN="replace-with-a-long-random-secret"

# ---------------------------------------------------------------------------
# Teemill API (OPTIONAL). The core app works fully without these.
# Find these in Teemill Pro → Settings → API.
# Only the SUPPORTED, read-only / order endpoints are ever called.
# ---------------------------------------------------------------------------

# Your Teemill API identifier (the "username" in calls), e.g. simply-posh-kat-apparel-164465
TEEMILL_ACCOUNT_ID=""

# Public Safe Key — safe to expose, returns basic public info only.
TEEMILL_PUBLIC_KEY=""

# Private Secure Key — account-level (can create orders / charge card).
# Leave BLANK to keep order/live-product features disabled.
# If this ever leaks, revoke + regenerate it in Teemill immediately.
TEEMILL_PRIVATE_KEY=""

# Optional: only set for a fully custom production domain.
# BETTER_AUTH_URL="https://your-domain.com"
